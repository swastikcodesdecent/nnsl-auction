rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Confined Sector / Internal Event Deployment
    // No login/auth system required. Open access for live screens, auctioneer consoles, and dashboard within the venue network.
    
    // --- Tournament Configuration & Rules ---
    match /tournament/{docId} {
      allow read, write: if true;
    }

    // --- Live Auction State ---
    // Synchronizes the live broadcast screen and auctioneer console in real-time
    match /auctionState/{docId} {
      allow read, write: if true;
    }

    // --- Players Roster ---
    // Supports CSV bulk upload, manual player entry, and real-time status updates (AVAILABLE, LIVE, SOLD, UNSOLD)
    match /players/{playerId} {
      allow read, write: if true;
    }

    // --- Teams & Purse Balances ---
    // Real-time synchronization of club budgets, spending, and squad lists
    match /teams/{teamId} {
      allow read, write: if true;
    }

    // --- Audit Trail & Transaction Logs ---
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // --- User Roles & Settings ---
    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
